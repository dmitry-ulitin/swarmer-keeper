{
  "name": "swarmer-keeper",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"pnpm --filter @swarmer-keeper/api dev\" \"pnpm --filter @swarmer-keeper/api dev:worker\" \"pnpm --filter @swarmer-keeper/web start\"",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "gen:client": "pnpm --filter @swarmer-keeper/api openapi && pnpm --filter @swarmer-keeper/api-client generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0"
  }
}
